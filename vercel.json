{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/autobeat/dist/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/artifacts/autobeat/dist/public/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/autobeat/dist/public/index.html"
    }
  ],
  "installCommand": "pnpm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "artifacts/autobeat/dist/public"
}
